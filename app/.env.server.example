# vCard App - Server Environment Variables
# Copy this file to .env.server and fill in your actual values

# Database Configuration
# NOTE: you can let Wasp set up your Postgres DB by running `wasp start db` in a separate terminal window.
# then, in a new terminal window, run `wasp db migrate-dev` and finally `wasp start`.
# If you use `wasp start db` then you DO NOT need to add a DATABASE_URL env variable here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vcard_db

# Stripe Payment Configuration
# For testing, go to https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_your_stripe_key_here
# After starting the stripe cli with `stripe listen --forward-to localhost:3001/payments-webhook`
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# You can find your Stripe customer portal URL in the Stripe Dashboard under the 'Customer Portal' settings
STRIPE_CUSTOMER_PORTAL_URL=http://localhost:3000/fake-portal

# Credit Pack Price ID
# Go to https://dashboard.stripe.com/test/products and create a product for "40 Credits" at $9.99 (one-time payment)
# Copy the price ID (starts with price_) and paste below
PAYMENTS_CREDITS_PLAN_ID=price_your_credits_price_id_here

# Admin Configuration
# Comma-separated list of emails that get admin privileges upon registration
ADMIN_EMAILS=admin@yourdomain.com,owner@yourdomain.com

# Google OAuth (Optional)
# See guide: https://wasp.sh/docs/auth/social-auth/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Configuration
# Get your SendGrid API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# OpenAI API (Optional - for future OCR feature)
# Get your API key at https://platform.openai.com/account
OPENAI_API_KEY=sk-proj-your_openai_key_here

# Plausible Analytics (Optional)
# Get your API key at https://plausible.io/login
PLAUSIBLE_API_KEY=your_plausible_api_key_here
PLAUSIBLE_SITE_ID=yourdomain.com
PLAUSIBLE_BASE_URL=https://plausible.io/api

# Google Analytics (Optional)
# Get service account key at https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_ANALYTICS_CLIENT_EMAIL=your-service-account@example.gserviceaccount.com
# Convert private key to base64: echo -n "PRIVATE_KEY" | base64
GOOGLE_ANALYTICS_PRIVATE_KEY=your_base64_encoded_private_key_here
GOOGLE_ANALYTICS_PROPERTY_ID=your_property_id_here

# AWS S3 Configuration (REQUIRED for business card upload feature)
# Create IAM user with S3 access at https://console.aws.amazon.com
AWS_S3_IAM_ACCESS_KEY=your_access_key_here
AWS_S3_IAM_SECRET_KEY=your_secret_key_here
AWS_S3_FILES_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1
