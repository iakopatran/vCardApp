# Build stage - use Debian-based image (Wasp requires glibc)
FROM node:22-slim AS builder

# Install dependencies for wasp
RUN apt-get update && apt-get install -y curl ca-certificates && rm -rf /var/lib/apt/lists/*

# Install wasp CLI (version 0.18 for this project)
RUN curl -sSL https://get.wasp.sh/installer.sh | sh -s -- -v 0.18.0
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

# Copy application files
COPY . .

# Replace Dummy email provider with SendGrid for production build
RUN sed -i 's/provider: Dummy/provider: SendGrid/' main.wasp

# Build the Wasp application
RUN wasp build

# Build the client
WORKDIR /app/.wasp/build/web-app

# Set the API URL for the client build
ENV REACT_APP_API_URL=http://localhost:3001

# Add npm overrides to force single React version and install deps
RUN npm pkg set overrides.react=18.2.0 overrides.react-dom=18.2.0 && \
    npm install --legacy-peer-deps && \
    npm dedupe && \
    npx vite build

# Production stage - serve with nginx
FROM nginx:alpine

# Copy built client files
COPY --from=builder /app/.wasp/build/web-app/build /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
