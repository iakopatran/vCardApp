# vCard App - Client Environment Variables
# All client-side env vars must start with REACT_APP_ or VITE_
# See: https://wasp.sh/docs/project/env-vars

# Google Analytics (Optional)
# See https://docs.opensaas.sh/guides/analytics/#google-analytics
REACT_APP_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Tile Service URL (REQUIRED)
# Development: http://localhost:8000
# Production: https://tiles.yourdomain.com (or your tile service URL)
VITE_TILE_SERVICE_URL=http://localhost:8000
